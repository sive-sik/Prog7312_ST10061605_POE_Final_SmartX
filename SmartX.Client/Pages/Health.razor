<h3>Health</h3>

@code {

}
@page "/health"
@using System.Net.Http.Json
@using SmartX.Core.Models
@inject HttpClient Http

<PageTitle>Smart-X Device Health</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Device Health & Anomaly Dashboard</h1>

            <p class="text-muted mb-0">
                Monitor Smart-X IoT devices for abnormal telemetry,
                connectivity problems and potential hardware faults.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="LoadHealth">
            Refresh Device Health
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Registered Devices</h6>
                    <h2 class="fw-bold">@deviceHealth.Count</h2>
                    <small>Smart-X IoT nodes</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-success h-100">
                <div class="card-body">
                    <h6 class="text-muted">Healthy</h6>
                    <h2 class="fw-bold text-success">@HealthyCount</h2>
                    <small>Operating normally</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-body">
                    <h6 class="text-muted">Warnings</h6>
                    <h2 class="fw-bold text-warning">@WarningCount</h2>
                    <small>Require attention</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-danger h-100">
                <div class="card-body">
                    <h6 class="text-muted">Critical</h6>
                    <h2 class="fw-bold text-danger">@CriticalCount</h2>
                    <small>Immediate investigation</small>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Active Smart-X Device States</h5>
        </div>

        <div class="card-body">

            @if (deviceHealth.Count == 0)
            {
                <p class="mb-0">
                    No registered devices are currently available.
                </p>
            }
            else
            {
                @foreach (DeviceHealthStatus device in deviceHealth)
                {
                    <div class="border rounded p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>
                                <h5 class="mb-1">
                                    @device.DeviceName
                                </h5>

                                <div class="text-muted">
                                    @device.MacAddress
                                </div>

                                <div class="text-muted">
                                    @device.Location
                                </div>
                            </div>

                            <span class="badge @GetStatusClass(device.Status)">
                                @device.Status
                            </span>

                        </div>

                        <hr />

                        <div class="row">

                            <div class="col-md-4">
                                <strong>Metric</strong>
                                <div>@device.Metric</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Latest Reading</strong>
                                <div>@device.LatestReading</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Last Contact</strong>

                                <div>
                                    @(device.LastContact.HasValue
                                        ? device.LastContact.Value
                                            .ToLocalTime()
                                            .ToString("HH:mm:ss")
                                        : "Never")
                                </div>
                            </div>

                        </div>

                        @if (device.Status != "Healthy")
                        {
                            <div class="alert @GetAlertClass(device.Status) mt-3 mb-0">

                                <strong>
                                    Smart-X Troubleshooting Guidance
                                </strong>

                                <div class="mt-1">
                                    @device.Recommendation
                                </div>

                            </div>
                        }

                    </div>
                }
            }

        </div>

    </div>

</div>

@code {

    private List<DeviceHealthStatus> deviceHealth = new();

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealth();
    }

    private async Task LoadHealth()
    {
        try
        {
            List<DeviceHealthStatus>? result =
                await Http.GetFromJsonAsync<List<DeviceHealthStatus>>(
                    "api/health");

            deviceHealth = result ?? new();

            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load device health: {ex.Message}";
        }
    }

    private int HealthyCount =>
        deviceHealth.Count(x => x.Status == "Healthy");

    private int WarningCount =>
        deviceHealth.Count(x => x.Status == "Warning");

    private int CriticalCount =>
        deviceHealth.Count(x => x.Status == "Critical");

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Healthy" => "bg-success",
            "Warning" => "bg-warning text-dark",
            "Critical" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetAlertClass(string status)
    {
        return status switch
        {
            "Warning" => "alert-warning",
            "Critical" => "alert-danger",
            _ => "alert-secondary"
        };
    }
}