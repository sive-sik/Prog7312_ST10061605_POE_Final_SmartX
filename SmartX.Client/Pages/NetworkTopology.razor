@page "/network-topology"
@using System.Net.Http.Json
@using SmartX.Core.Models
@inject HttpClient Http

<PageTitle>SmartX Network Topology</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Network Topology &amp; Mesh Routing</h1>
            <p class="text-muted mb-0">Explore ESP32 mesh connections, routing paths, network failures and historical telemetry.</p>
        </div>
        <button class="btn btn-primary" @onclick="LoadDashboard" disabled="@isLoading">Refresh Network</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h6 class="text-muted">Registered Nodes</h6><h2>@topology.NodeIds.Count</h2></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h6 class="text-muted">Wireless Links</h6><h2>@topology.Links.Count</h2></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h6 class="text-muted">Offline Nodes</h6><h2>@topology.OfflineNodeIds.Count</h2></div></div></div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white"><h5 class="mb-0">Mesh Topology</h5></div>
                <div class="card-body">
                    @if (topology.NodeIds.Count == 0)
                    {
                        <p class="text-muted">No registered devices. Add sensors on the Sensor Data page first.</p>
                    }
                    else
                    {
                        <svg viewBox="0 0 600 350" role="img" aria-label="Network nodes and wireless connections" style="width:100%;height:auto;border:1px solid #dee2e6;border-radius:8px;background:#f8f9fa">
                            @foreach (MeshLink link in topology.Links)
                            {
                                var start = Position(link.FromId);
                                var end = Position(link.ToId);
                                <line x1="@start.X" y1="@start.Y" x2="@end.X" y2="@end.Y" stroke="@(IsMstLink(link) ? "#0d6efd" : "#adb5bd")" stroke-width="@(IsMstLink(link) ? 4 : 2)" />
                                <text x="@((start.X + end.X) / 2)" y="@((start.Y + end.Y) / 2 - 5)" text-anchor="middle" font-size="13">@link.Weight</text>
                            }
                            @foreach (Guid id in topology.NodeIds)
                            {
                                var position = Position(id);
                                <circle cx="@position.X" cy="@position.Y" r="22" fill="@(topology.OfflineNodeIds.Contains(id) ? "#dc3545" : "#198754")" stroke="white" stroke-width="3" />
                                <text x="@position.X" y="@(position.Y + 4)" text-anchor="middle" fill="white" font-size="13">@(topology.NodeIds.IndexOf(id) + 1)</text>
                                <text x="@position.X" y="@(position.Y + 37)" text-anchor="middle" font-size="11">@ShortName(id)</text>
                            }
                        </svg>
                        <p class="small text-muted mt-2 mb-0">Green = active, red = offline, blue links = Prim minimum spanning tree. Node numbers match the device list.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white"><h5 class="mb-0">Registered Mesh Devices</h5></div>
                <div class="card-body">
                    @foreach (SensorDevice device in devices)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2 gap-2">
                            <div><strong>@device.Name</strong><div class="small text-muted">@device.MacAddress</div></div>
                            <button class="btn btn-sm @(topology.OfflineNodeIds.Contains(device.Id) ? "btn-outline-success" : "btn-outline-danger")" @onclick="() => ToggleOffline(device.Id)" disabled="@isLoading">
                                @(topology.OfflineNodeIds.Contains(device.Id) ? "Restore" : "Simulate Failure")
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white"><h5 class="mb-0">Create Wireless Link</h5></div>
                <div class="card-body">
                    <label class="form-label">From device</label>
                    <select class="form-select mb-2" @bind="fromId">
                        @foreach (SensorDevice device in devices) { <option value="@device.Id">@device.Name</option> }
                    </select>
                    <label class="form-label">To device</label>
                    <select class="form-select mb-2" @bind="toId">
                        @foreach (SensorDevice device in devices) { <option value="@device.Id">@device.Name</option> }
                    </select>
                    <label class="form-label">Link cost / weight</label>
                    <input type="number" min="0.1" step="0.1" class="form-control mb-3" @bind="weight" />
                    <button class="btn btn-primary" disabled="@(isLoading || devices.Count < 2)" @onclick="CreateLink">Add Link</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white"><h5 class="mb-0">BFS Routing &amp; Connectivity</h5></div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5"><label class="form-label">Source</label><select class="form-select" @bind="fromId">@foreach (SensorDevice device in devices) { <option value="@device.Id">@device.Name</option> }</select></div>
                <div class="col-md-5"><label class="form-label">Destination</label><select class="form-select" @bind="toId">@foreach (SensorDevice device in devices) { <option value="@device.Id">@device.Name</option> }</select></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" disabled="@(isLoading || devices.Count < 2)" @onclick="FindRoute">Find Route</button></div>
            </div>
            @if (route != null)
            {
                <p class="mt-3 mb-0"><strong>Result:</strong> @(route.Reachable ? string.Join(" → ", route.Path.Select(ShortName)) : "No available route")</p>
                @if (route.Reachable) { <p class="small text-muted mb-0">Hop count: @route.HopCount</p> }
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white"><h5 class="mb-0">AVL Historical Telemetry Query</h5></div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5"><label class="form-label">Start (UTC)</label><input type="datetime-local" class="form-control" @bind="startTime" @bind:format="yyyy-MM-ddTHH:mm" /></div>
                <div class="col-md-5"><label class="form-label">End (UTC)</label><input type="datetime-local" class="form-control" @bind="endTime" @bind:format="yyyy-MM-ddTHH:mm" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" disabled="@isLoading" @onclick="SearchHistory">Search</button></div>
            </div>
            <p class="small text-muted mt-2">Searches processed telemetry indexed by the AVL tree. Use the Command Stream page to process readings first.</p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th>Timestamp (UTC)</th><th>Device</th><th>Metric</th><th>Reading</th></tr></thead>
                    <tbody>
                        @foreach (StreamTelemetryItem item in history)
                        {
                            <tr><td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@item.DeviceName</td><td>@item.Metric</td><td>@item.Value @item.Unit</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (history.Count == 0) { <p class="text-muted">No readings in the selected range.</p> }
        </div>
    </div>
</div>

@code {
    private List<SensorDevice> devices = new();
    private MeshTopologySnapshot topology = new();
    private MeshRouteResult? route;
    private List<StreamTelemetryItem> history = new();
    private Guid fromId;
    private Guid toId;
    private double weight = 1;
    private DateTime startTime = DateTime.UtcNow.AddDays(-1);
    private DateTime endTime = DateTime.UtcNow.AddDays(1);
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadDashboard();

    private async Task LoadDashboard()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            devices = await Http.GetFromJsonAsync<List<SensorDevice>>("api/realtime/devices") ?? new();
            topology = await Http.GetFromJsonAsync<MeshTopologySnapshot>("api/mesh/topology") ?? new();
            if (devices.Count > 0 && !devices.Any(device => device.Id == fromId)) { fromId = devices[0].Id; }
            if (devices.Count > 1 && !devices.Any(device => device.Id == toId)) { toId = devices[1].Id; }
        }
        catch (Exception error) { errorMessage = $"Unable to load network: {error.Message}"; }
        finally { isLoading = false; }
    }

    private (double X, double Y) Position(Guid id)
    {
        int index = topology.NodeIds.IndexOf(id);
        int count = Math.Max(1, topology.NodeIds.Count);
        double angle = 2 * Math.PI * index / count - Math.PI / 2;
        return (300 + 205 * Math.Cos(angle), 175 + 115 * Math.Sin(angle));
    }

    private string ShortName(Guid id)
    {
        SensorDevice? device = devices.FirstOrDefault(item => item.Id == id);
        return device?.Name ?? id.ToString()[..8];
    }

    private bool IsMstLink(MeshLink link) => topology.MinimumSpanningTree.Any(item =>
        (item.FromId == link.FromId && item.ToId == link.ToId)
        || (item.FromId == link.ToId && item.ToId == link.FromId));

    private async Task CreateLink()
    {
        await PerformAction(async () =>
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/mesh/links", new MeshLinkRequest { FromId = fromId, ToId = toId, Weight = weight });
            await EnsureSuccess(response);
            successMessage = "Wireless link saved.";
        });
    }

    private async Task ToggleOffline(Guid id)
    {
        await PerformAction(async () =>
        {
            bool offline = !topology.OfflineNodeIds.Contains(id);
            HttpResponseMessage response = await Http.PostAsJsonAsync($"api/mesh/devices/{id}/status", new MeshStatusRequest { Offline = offline });
            await EnsureSuccess(response);
            successMessage = offline ? "Node disconnected. Routes and MST recalculated." : "Node restored.";
        });
    }

    private async Task FindRoute()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            route = await Http.GetFromJsonAsync<MeshRouteResult>($"api/mesh/route?fromId={fromId}&toId={toId}");
        }
        catch (Exception error) { errorMessage = error.Message; }
        finally { isLoading = false; }
    }

    private async Task SearchHistory()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            string start = Uri.EscapeDataString(startTime.ToString("O"));
            string end = Uri.EscapeDataString(endTime.ToString("O"));
            history = await Http.GetFromJsonAsync<List<StreamTelemetryItem>>($"api/telemetry-history/range?start={start}&end={end}") ?? new();
        }
        catch (Exception error) { errorMessage = error.Message; }
        finally { isLoading = false; }
    }

    private async Task PerformAction(Func<Task> action)
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        try
        {
            await action();
            topology = await Http.GetFromJsonAsync<MeshTopologySnapshot>("api/mesh/topology") ?? new();
            route = null;
        }
        catch (Exception error) { errorMessage = error.Message; }
        finally { isLoading = false; }
    }

    private static async Task EnsureSuccess(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
        }
    }
}
